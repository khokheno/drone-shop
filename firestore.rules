rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Store settings and parts: anyone can read, only admins can change.
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Extra photos of a part (the cover photo is on the part itself).
    match /products/{id}/photos/{photo} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: customers can only create a new order in the expected shape.
    // Only admins can read, update or delete orders.
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(['number', 'items', 'total', 'customer', 'status', 'createdAt'])
        && request.resource.data.status == 'new'
        && request.resource.data.number is string && request.resource.data.number.size() <= 20
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 100
        && request.resource.data.total is number
        && request.resource.data.customer is map
        && request.resource.data.customer.keys().hasOnly(['name', 'phone', 'city', 'note'])
        && request.resource.data.customer.name is string && request.resource.data.customer.name.size() <= 120
        && request.resource.data.customer.get('phone', '') is string && request.resource.data.customer.get('phone', '').size() <= 30
        && request.resource.data.customer.city is string && request.resource.data.customer.city.size() <= 120
        && request.resource.data.customer.note is string && request.resource.data.customer.note.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Admin list: managed from the Firebase console only.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
